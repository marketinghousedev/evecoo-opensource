Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# API has its own front controller (api/.htaccess)
RewriteRule ^api/ - [L]

# Shell pages for dynamic ids
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^card/[^/]+/?$ card/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^join/[^/]+/?$ join/index.html [L]

# /x -> /x/index.html (trailingSlash export)
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+[^/])$ $1/index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" NEXT_STATIC=1
    Header set Cache-Control "public, max-age=31536000, immutable" env=NEXT_STATIC
  </IfModule>
</IfModule>
