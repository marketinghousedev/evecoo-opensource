{
  "name": "evecoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-messages.mjs && node scripts/gen-illo-index.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-messages.mjs && node scripts/gen-illo-index.mjs",
    "build": "next build",
    "bundle": "npm run build && scripts/build-bundle.sh",
    "svg:optimize": "node scripts/svg-optimize.mjs",
    "passes:gen": "node scripts/gen-passes.mjs && npm run svg:optimize",
    "stamps:gen": "node scripts/gen-stamps.mjs && npm run svg:optimize",
    "illo:index": "node scripts/gen-illo-index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "svgo": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
