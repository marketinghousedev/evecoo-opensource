{
    "name": "evecoo/api",
    "description": "evecoo PHP API (dev tooling only; the bundle has zero runtime dependencies)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Evecoo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
