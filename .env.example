# No environment variables are required for the app itself.
# PHP reads its configuration from a config file (see README, "Configuration"):
#   EVECOO_CONFIG=/absolute/path/to/config.php   # local dev only, e.g. php/config.local.php
# EVECOO_TEST_DSN / EVECOO_TEST_USER / EVECOO_TEST_PASS switch the PHPUnit suite to MariaDB/MySQL.
